<mvc:View controllerName="com.gcc.eforms.ex01.ex01.controller.View1"
    xmlns:mvc="sap.ui.core.mvc" xmlns:core="sap.ui.core" displayBlock="true"
    xmlns="sap.m" xmlns:f="sap.ui.layout.form" >
    <Page id="page" showHeader="false" >
        <content>
         <IconTabBar id="_IDGenIconTabBar1" backgroundDesign="Solid" expandable="true" select="onTabChange">
            <items>
               <IconTabFilter id="_IDGenIconTabFilter1" text="{i18n>FormText}" key="i18n>FormText">
                  <VBox id="_IDGenVBox1" class="sapUiSmallMargin">
                     <!--Begin of INTRODUCTION-->
                     <Panel id="_IDGenPanel1" expandable="true" expanded="true" stickyHeader="true" headerText="{i18n>Intro}" width="auto" class="sapUiResponsiveMargin">
                           <FormattedText id="_IDGenFormattedText1" ></FormattedText>
                     </Panel>
                     <!-- End Of Introduction -->
                     <!-- Begin Of Header -->
                     <Panel id="_IDGenPanel2" expandable="true" expanded="true" stickyHeader="true" headerText="{i18n>Head}" width="auto" class="sapUiResponsiveMargin">
                       <f:SimpleForm id="_IDGenSimpleForm" layout="ColumnLayout" labelSpanM="4" labelSpanL="3" labelSpanXL="3" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsM="3" columnsL="3" columnsXL="3" >
                           <f:content>
                              <Label id="_IDGenLabel1" text="{i18n>Initiator}" showColon="true" labelFor="_IDGenInput1" />
                              <Input id="_IDGenInput1" editable="false" value="{Model1>/initNameP/salutationLabel} {Model1>/initNameP/firstNameInit} {Model1>/initNameP/lastNameInit}" />

                              <Label id="_IdGenLabel6" text="Organisation Name" showColon="true" labelFor="_IdGenInput6" />
                              <ComboBox id="_IdGenInput6" value="{Model1>/OrgNameP/customString3}" items="{path: 'Model1>/OrgValues', templateShareable:false, sorter: {path: 'Model1>value' }}" change="onOrgChange" editable="{= ${Model1>/Param/mode} !== 'display'}" >
                                 <items>
                                    <core:Item id="_IDGenItem1" key="{Model1>key}" text="{Model1>value} ({Model1>key})" />
                                 </items>
                              </ComboBox>

                              <Label id="_IdGenLabel01" text="Claim End Date" required="true" showColon="true" labelFor="_IDGenDatePicker1" />
                              <DatePicker id="_IDGenDatePicker1" editable="false" change="onClaimEndDate" value="{Model1>/ClaimEndDate}" />

                              <Label id="_IDGenLabel2" text="{i18n>Form}" showColon="true" labelFor="_IDGenInput2" />
                              <Input id="_IDGenInput2"  editable="false"/>

                              <Label id="_IdGenLabel5" text="Cost Centre" showColon="true" labelFor="_IdGenInput5" />
                              <Input id="_IdGenInput5" editable="false" value="{Model1>/CostCentreP/costCenter}" />
                              
                              <Label id="_IDGenLabel3" text="Date" showColon="true" labelFor="DatePicker01" />
                              <DatePicker id="DatePicker01" editable="false" />

                              <Label id="_IdGenLabel9" text="Claim Month" showColon="true" required="true" labelFor="_IDGenComboBox1" />
                              <ComboBox id="_IDGenComboBox1" editable="{= ${Model1>/form/mode} !== 'display' }" items="{path: 'Model1>/PrevSixMonths', templateShareable:false}" change="onMonth" tooltip="{i18n>ClaimMonth}" >
                                 <items>
                                    <core:Item id="_IDGenItem2" key="{Model1>key}" text="{Model1>months}" />
                                 </items>
                              </ComboBox>
                         </f:content>
                        </f:SimpleForm>
                     </Panel>
                     <!-- End Of Header -->
                     <!-- Begin Of Section A -->
                     <Panel id="_IDGenPanel3" headerText="Section A - Mileage Claims" expandable="true" expanded="true" width="auto" class="sapUiResponsiveMargin">
                        <Table id="_IDGenTable1" mode="MultiSelect" items="{Model1>/SecAData}" width="auto" >
                           <headerToolbar>
                              <OverflowToolbar id="_IDGenOverflowToolbar1">
                                 <content>
                                    <!--  <Title id="_IDGenTitle1" text="Section A - Claim Hours" level="H2"/>  -->
                                    <ToolbarSpacer id="_IDGenToolbarSpacer1" />
                                    <Button id="toggleInfoToolbar1" text="Add Row" press="onAddRowTab1"  visible="{= ${Model1>/form/mode} !== 'display' }" />
                                    <Button id="toggleInfoToolbar2" text="Delete Row" press="onDelRowTab1" visible="{= ${Model1>/form/mode} !== 'display' }" />
                                 </content>
                              </OverflowToolbar>
                           </headerToolbar>
                           <columns>
                              <Column id="_IDGenColumn1" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="45%" >
                                 <Label id="_IDGenLabel14" text="Emp.Name/Per no./Position" required="true" labelFor="_IDGenComboBox2" />
                              </Column>
                              <Column id="_IDGenColumn2" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="25%">
                                 <Label id="_IDGenLabel10" text="Vehicle Type" required="true" labelFor="_IDGenInput7" />
                              </Column>
                              <!-- <Column id="_IDGenColumn3" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="17%">
                                 <Label id="_IDGenLabel11" text="Vehicle Class" labelFor="_IDGenInput3" />
                              </Column> -->
                              <Column id="_IDGenColumn4" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="auto">
                                 <Label id="_IDGenLabel12" text="No of Miles" required="true" labelFor="_IDGenInput4" />
                              </Column>
                              <Column id="_IDGenColumn5" width="10%" hAlign="Center">
                                 <Label id="_IDGenLabel13" text="" />
                              </Column>
                           </columns>
                           <items>
                              <ColumnListItem id="_IDGenColumnListItem1" fieldGroupIds="checkSecA" >
                                 <ComboBox id="_IDGenComboBox2" width="100%" value="{Model1>empName}" required="false" items="{path: 'Model1>/dropdownEmp', templateShareable:false, length: 10000}" change="onEmplChangeSecA" editable="{= ${Model1>/form/mode} !== 'display'}" tooltip="{i18n>empSel}" valueStateText="Enter a valid Employee Name" >
                                    <items>
                                       <core:Item id="_IDGenItem3" key="{Model1>userId}" text="{Model1>lastName} {Model1>firstName} {Model1>userId} {Model1>jobTitle}" bindingContexts="{Model1>jobTitle}" />
                                    </items>
                                 </ComboBox>
                                 <ComboBox id="_IDGenInput7" width="100%" value="{Model1>VehicleType}" required="{Model1>enableVehicleType}" items="{path: 'Model1>dropdownVehType', templateShareable:false}" change="onVehTypeChangeSecA" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableVehicleType} : false}" tooltip="{i18n>vehicleType}" valueStateText="Vehicle Type is a required field" >
                                 <items>
                                       <core:Item id="_IDGenItem4" key="{Model1>key}" text="{Model1>cust_VehicleType}" />
                                    </items>
                                 </ComboBox>
                                 <!-- <ComboBox id="_IDGenInput3" width="100%" value="{Model1>VehicleClass}" items="{path: 'Model1>dropdownVehClass', templateShareable:false}" change="onVehClassChangeSecA" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableVehicleClass} : false}" required="{Model1>enableVehicleClass}" tooltip="{i18n>vehicleClass}" valueStateText="Vehicle Class is a required field" >
                                 <items>
                                       <core:Item id="_IDGenItem5" key="{Model1>cust_VehicleID}" text="{Model1>cust_VehicleClass}" />
                                    </items>
                                 </ComboBox> -->
                                 <Input id="_IDGenInput4" width="100%" value="{Model1>NumberOfMiles}" liveChange="numberValidation" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableMiles} : false}" tooltip="{i18n>NoOfMiles}" required="{Model1>enableMiles}" valueStateText="Number of miles is a required field" change="onInputChange" />
                                 <Button id="_IDGenButton1" type="Emphasized" text="Show" press="onShowPress1" tooltip="Add comments about this claim here" />
                              </ColumnListItem>
                           </items>
                        </Table>
                     </Panel>
                     <!-- End OF Section A -->
                     <!-- Begin Of Section B -->
                     <Panel id="_IDGenPanel4" headerText="Section B - Expenses Claims" expandable="true" expanded="true" width="auto" class="sapUiResponsiveMargin">
                        <Table id="_IDGenTable2" mode="MultiSelect" items="{Model1>/SecBData}" width="auto">
                           <headerToolbar>
                              <OverflowToolbar id="_IDGenOverflowToolbar2">
                                 <content>
                                    <!--  <Title id="_IDGenTitle1" text="Section A - Claim Hours" level="H2"/>  -->
                                    <ToolbarSpacer id="_IDGenToolbarSpacer2" />
                                    <Button id="toggleInfoToolbar3" text="Add Row" press="onAddRowTab2" visible="{= ${Model1>/form/mode} !== 'display' }" />
                                    <Button id="toggleInfoToolbar4" text="Delete Row" press="onDelRowTab2" visible="{= ${Model1>/form/mode} !== 'display' }" />
                                 </content>
                              </OverflowToolbar>
                           </headerToolbar>
                           <columns>
                              <Column id="_IDGenColumn6" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="50%">
                                 <Label id="_IDGenLabel15" text="Emp.Name/Per no./Position" required="true" labelFor="_IDGenComboBox3" />
                              </Column>
                              <Column id="_IDGenColumn7" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="25%">
                                 <Label id="_IDGenLabel16" text="Expense Type" required="true" labelFor="_IDGenInput8" />
                              </Column>
                              <Column id="_IDGenColumn8" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="auto">
                                 <Label id="_IDGenLabel17" text="Amount(£)" required="true" labelFor="_IDGenInput9" />
                              </Column>
                              <Column id="_IDGenColum9" width="10%" hAlign="Center">
                                 <Label id="_IDGenLabel18" text="" />
                              </Column>
                           </columns>
                           <items>
                              <ColumnListItem id="_IDGenColumnListItem2" fieldGroupIds="checkSecB">
                                 <ComboBox id="_IDGenComboBox3" width="100%" value="{Model1>empName}" items="{path: 'Model1>/dropdownEmp', templateShareable:false, length: 10000}" required="false" change="onEmplChangeSecB" editable="{= ${Model1>/form/mode} !== 'display'}" tooltip="{i18n>empSel}" valueStateText="Enter a valid Employee Name" >
                                    <items>
                                       <core:Item id="_IDGenItem6" key="{Model1>userId}" text="{Model1>lastName} {Model1>firstName} {Model1>userId} {Model1>jobTitle}" />
                                    </items>
                                 </ComboBox>
                                 <ComboBox id="_IDGenInput8" width="100%" items="{path: 'Model1>dropdownExpType', templateShareable:false }" value="{Model1>ExpenseType}" change="onExpenseChangeSecB" required="{Model1>enableExpense}" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableExpense} : false}" tooltip="{i18n>ExpenseType}" valueStateText="Expense Type is a required field" >
                                    <items>
                                       <core:Item id="_IDGenItem7" key="{Model1>cust_ExpenseType}" text="{Model1>cust_ExpenseID}" />
                                    </items>
                                 </ComboBox>
                                 <Input id="_IDGenInput9" width="100%" value="{Model1>Amount}" liveChange="floatValidation" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableAmount} : false}" tooltip="{i18n>Amount}" required="{Model1>enableAmount}" valueStateText="Amount is a required field" change="onAmountChange" />
                                 <Button id="_IDGenButton2" type="Emphasized" text="Show" press="onShowPress1" tooltip="Add comments about this claim here" />
                              </ColumnListItem>
                           </items>
                        </Table>
                     </Panel>
                     <!-- End Of Section B -->
                     <!-- Begin Of Section C -->
                     <Panel id="_IDGenPanel5" headerText="Section C - Supply Mileage" expandable="true" expanded="true" width="auto" class="sapUiResponsiveMargin">
                        <Table id="_IDGenTable3" mode="MultiSelect" items="{Model1>/SecCData}" width="auto">
                           <headerToolbar>
                              <OverflowToolbar id="_IDGenOverflowToolbar3">
                                 <content>
                                    <!--  <Title id="_IDGenTitle1" text="Section A - Claim Hours" level="H2"/>  -->
                                    <ToolbarSpacer id="_IDGenToolbarSpacer3" />
                                    <Button id="toggleInfoToolbar5" text="Add Row" press="onAddRowTab3" visible="{= ${Model1>/form/mode} !== 'display' }" />
                                    <Button id="toggleInfoToolbar6" text="Delete Row" press="onDelRowTab3" visible="{= ${Model1>/form/mode} !== 'display' }" />
                                 </content>
                              </OverflowToolbar>
                           </headerToolbar>
                           <columns>
                              <Column id="_IDGenColumn10" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="15%">
                                 <Label id="_IDGenLabel19" text="Personnel Number" required="true" labelFor="_IDGenInput10" />
                              </Column>
                              <Column id="_IDGenColumn11" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="30%">
                                 <Label id="_IDGenLabel20" text="Employee Name" required="true" labelFor="_IDGenInput11" />
                              </Column>
                              <Column id="_IDGenColumn12" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="25%">
                                 <Label id="_IDGenLabel21" text="Vehicle Type" required="true" labelFor="_IDGenInput12" />
                              </Column>
                              <!-- <Column id="_IDGenColumn13" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="17%">
                                 <Label id="_IDGenLabel22" text="Vehicle Class" labelFor="_IDGenInput13" />
                              </Column> -->
                              <Column id="_IDGenColumn14" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="auto">
                                 <Label id="_IDGenLabel23" text="No of Miles" required="true" labelFor="_IDGenInput14" />
                              </Column>
                              <Column id="_IDGenColum15" width="10%" hAlign="Center">
                                 <Label id="_IDGenLabel24" text="" />
                              </Column>
                           </columns>
                           <items>
                              <ColumnListItem id="_IDGenColumnListItem3" fieldGroupIds="checkSecC">
                                 <Input id="_IDGenInput10" width="100%" value="{Model1>PersonID}" change="onIDChange" tooltip="{i18n>PersonnelNo}" required="false" editable="{= ${Model1>/form/mode} !== 'display'}" valueStateText="Enter a valid Personnel Number" />
                                 <Input id="_IDGenInput11" width="100%" value="{Model1>empName}" editable="false" />
                                 <ComboBox id="_IDGenInput71" width="100%" value="{Model1>VehicleType}" items="{path: 'Model1>dropdownVehType', templateShareable:false}" change="onVehTypeChangeSecA" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableVehicleType} : false}" tooltip="{i18n>vehicleType}" required="{Model1>enableVehicleType}" valueStateText="Vehicle Type is a required field" >
                                 <items>
                                       <core:Item id="_IDGenItem8" key="{Model1>key}" text="{Model1>cust_VehicleType}" />
                                    </items>
                                 </ComboBox>
                                 <!-- <ComboBox id="_IDGenInput31" width="100%" value="{Model1>VehicleClass}" items="{path: 'Model1>dropdownVehClass', templateShareable:false}" change="onVehClassChangeSecA" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableVehicleClass} : false}" tooltip="{i18n>vehicleClass}" required="{Model1>enableVehicleClass}" valueStateText="Vehicle Class is a required field" >
                                 <items>
                                       <core:Item id="_IDGenItem9" key="{Model1>cust_VehicleID}" text="{Model1>cust_VehicleClass}" />
                                    </items>
                                 </ComboBox> -->
                                 <Input id="_IDGenInput14" width="100%" value="{Model1>NumberOfMiles}" liveChange="numberValidation" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableMiles} : false}" tooltip="{i18n>NoOfMiles}" required="{Model1>enableMiles}" valueStateText="Number of miles is a required field" change="onInputChange" />
                                 <Button id="_IDGenButton3" type="Emphasized" text="Show" press="onShowPress1" tooltip="Add comments about this claim here" />
                              </ColumnListItem>
                           </items>
                        </Table>
                     </Panel>
                     <!-- End Of Section C -->
                     <!-- Begin Of Section D -->
                     <Panel id="_IDGenPanel6" headerText="Section D - Supply Expense" expandable="true" expanded="true" width="auto" class="sapUiResponsiveMargin">
                        <Table id="_IDGenTable4" mode="MultiSelect" items="{Model1>/SecDData}" width="auto">
                           <headerToolbar>
                              <OverflowToolbar id="_IDGenOverflowToolbar4">
                                 <content>
                                    <!--  <Title id="_IDGenTitle1" text="Section A - Claim Hours" level="H2"/>  -->
                                    <ToolbarSpacer id="_IDGenToolbarSpacer4" />
                                    <Button id="toggleInfoToolbar7" text="Add Row" press="onAddRowTab4" visible="{= ${Model1>/form/mode} !== 'display' }" />
                                    <Button id="toggleInfoToolbar8" text="Delete Row" press="onDelRowTab4" visible="{= ${Model1>/form/mode} !== 'display' }" />
                                 </content>
                              </OverflowToolbar>
                           </headerToolbar>
                           <columns>
                              <Column id="_IDGenColumn16" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="15%">
                                 <Label id="_IDGenLabel25" text="Personnel Number" required="true" labelFor="_IDGenInput15" />
                              </Column>
                              <Column id="_IDGenColumn17" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="25%">
                                 <Label id="_IDGenLabel26" text="Employee Name" required="true" labelFor="_IDGenInput16" />
                              </Column>
                              <Column id="_IDGenColumn18" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="30%">
                                 <Label id="_IDGenLabel27" text="Expense Type" required="true" labelFor="_IDGenInput17" />
                              </Column>
                              <Column id="_IDGenColumn19" minScreenWidth="Tablet" demandPopin="true" hAlign="Center" width="auto">
                                 <Label id="_IDGenLabel28" text="Amount(£)" required="true" labelFor="_IDGenInput18" />
                              </Column>
                              <Column id="_IDGenColumn20" width="10%" hAlign="Center">
                                 <Label id="_IDGenLabel29" text="" />
                              </Column>
                           </columns>
                           <items>
                              <ColumnListItem id="_IDGenColumnListItem4" fieldGroupIds="checkSecD">
                                 <Input id="_IDGenInput15" width="100%" value="{Model1>PersonID}" editable="{= ${Model1>/form/mode} !== 'display' }" change="onIDChangeSecD" tooltip="{i18n>PersonnelNo}" required="false" valueStateText="Enter a valid Personnel Number" />
                                 <Input id="_IDGenInput16" width="100%" value="{Model1>empName}" editable="false" />
                                  <ComboBox id="_IDGenInput81" width="100%" items="{path: 'Model1>dropdownExpType', templateShareable:false}" value="{Model1>ExpenseType}" change="onExpenseChangeSecB" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableExpense} : false}" tooltip="{i18n>ExpenseType}" required="{Model1>enableExpense}" valueStateText="Expense Type is a required field" >
                                    <items>
                                       <core:Item id="_IDGenItem10" key="{Model1>cust_ExpenseType}" text="{Model1>cust_ExpenseID}" />
                                    </items>
                                 </ComboBox>
                                 <Input id="_IDGenInput18" width="100%" value="{Model1>Amount}" liveChange="floatValidation" editable="{= ${Model1>/form/mode} !== 'display' ? ${Model1>enableAmount} : false}" tooltip="{i18n>Amount}" required="{Model1>enableAmount}" valueStateText="Amount is a required field" change="onAmountChange" />
                                 <Button id="_IDGenButton4" type="Emphasized" text="Show" press="onShowPress1" tooltip="Add comments about this claim here" />
                              </ColumnListItem>
                           </items>
                        </Table>
                     </Panel>
                     <!-- End Of Section D -->
                     <!-- Begin of Comments -->
                     <Panel id="_IDGenPanel7" expandable="true" expanded="true" width="auto" stickyHeader="true" headerText="{i18n>Comments}" class="sapUiResponsiveMargin">
                        <VBox id="_IDGenVBox2">
                           <Label id="_IDGenLabe20" text="{i18n>AuthComments}" showColon="true" visible="false" />
                           <TextArea id="_IDGenTextArea2" rows="5" cols="100" visible="false" editable="false" />
                           <Label id="_IDGenLabel4" text="Your Comments" showColon="true" class="sapUiSmallMarginTop" />
                           <TextArea id="_IDGenTextArea3" rows="3" cols="100" tooltip="{i18n>yourComments}" />
                           <Button id="button1" text="Add Comment" press="onAddComment" type="Emphasized" />
                        </VBox>
                     </Panel>
                     <!-- End of Comments -->
                     <!-- Begin of Section E -->
                     <Panel id="_IDGenPanel8" headerText="Section E - Notify Approver" expandable="true" expanded="true" class="sapUiResponsiveMargin" width="auto">
                        <content>
                           <CheckBox id="checkbox1" editable="{= ${Model1>/form/mode} !== 'display' }" text="{i18n>checkBoxText}" wrapping="true" />
                           <MessageStrip id="_IDGenMessageStrip1" text="{i18n>message}" />
                        </content>
                     </Panel>
                     <!-- End of Section E -->
                  </VBox>
               </IconTabFilter>
               <IconTabFilter id="_IDGenIconTabFilter2" text="History" key="History">
                  <Panel id="_IDGenPanel9" expandable="false" stickyHeader="true" headerText="Expenses Form" width="auto" class="sapUiResponsiveMargin" >
                        <Table id="_IDGenTable5" width="auto" delete="deleteRow" mode="MultiSelect" items="{Model1>/historyTable}">
                            <headerToolbar>
                                <Toolbar id="_IDGenToolbar5" width="auto" design="Solid" style="Standard">
                                    <Label id="_HIDGenLabel1" labelFor="_HIDGenFormId1" text="Form Id"/>
                                    <Input id="_HIDGenFormId1" width="auto" editable="false"/>
                                    <Label id="_HIDGenLabel2" labelFor="_HIDGenType1" text="Type"/>
                                    <Input id="_HIDGenType1" width="auto" editable="false" value="EX01"/>
                                </Toolbar>
                            </headerToolbar>
                            <columns>
                                <Column id="_HIDGenColumn1" demandPopin="true" minScreenWidth="Tablet" width="80px">
                                    <Text id="_HIDGenText1" text="{i18n>HCol1}"/>
                                </Column>
                                    <Column id="_HIDGenColumn2" demandPopin="true" minScreenWidth="Tablet">
                                    <Text id="_HIDGenText2" text="{i18n>HCol2}"/>
                                </Column>
                                <Column id="_HIDGenColumn3" demandPopin="true" minScreenWidth="Tablet">
                                    <Text id="_HIDGenText3" text="{i18n>HCol3}"/>
                                </Column>
                                <Column id="_HIDGenColumn4" demandPopin="true" minScreenWidth="Tablet">
                                    <Text id="_HIDGenText4" text="{i18n>HCol4}"/>
                                </Column>
                                <Column id="_HIDGenColumn5" demandPopin="true" minScreenWidth="Tablet">
                                    <Text id="_HIDGenText5" text="{i18n>HCol5}"/>
                                </Column>
                                <Column id="_HIDGenColumn6" demandPopin="true" minScreenWidth="Tablet">
                                    <Text id="_HIDGenText6" text="{i18n>HCol6}"/>
                                </Column>
                                <Column id="_HIDGenColumn7" demandPopin="true" minScreenWidth="Tablet">
                                    <Text id="_HIDGenText7" text="{i18n>HCol7}"/>
                                </Column>
                                <Column id="_HIDGenColumn8" demandPopin="true" minScreenWidth="Tablet">
                                    <Text id="_HIDGenText8" text="{i18n>HCol8}"/>
                                </Column>
                            </columns>
                            <items>
                                <ColumnListItem id="_IDGenColumnListItem6">
                                    <cells>
                                        <Input id="_HIDGenInput1" editable="false" value="{Model1>SeqNumber}" tooltip="Sequence Number" width="60px" />
                                        <Input id="_HIDGenInput2" editable="false" value="{Model1>Initiator}" tooltip="Initiator" />
                                        <Input id="_HIDGenInput3" editable="false" value="{Model1>StartedOn}" tooltip="Started On" />
                                        <Input id="_HIDGenInput4" editable="false" value="{Model1>OrganizationName}" tooltip="Organization Name" />
                                        <Input id="_HIDGenInput5" editable="false" value="{Model1>Description}" tooltip="Description" />
                                        <Input id="_HIDGenInput6" editable="false" value="{Model1>Status}" tooltip="Status" />
                                        <Input id="_HIDGenInput7" editable="false" value="{Model1>FormOwner}" tooltip="Form Owner" />
                                        <Input id="_HIDGenInput8" editable="false" value="{Model1>AvailableFrom}" tooltip="Available From" />
                                        <!-- <Input id="_HIDGenInput9" editable="false" value="{AllData>createdOn}" tooltip="Created On" /> -->
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </Panel>
               </IconTabFilter>
            </items>
         </IconTabBar>
      </content>
      <footer>
         <OverflowToolbar id="_IDGenToolbar8" tooltip="Select action required">
            <Button id="_IDGenButton5" type="Emphasized" icon="sap-icon://print" text="{i18n>Print}" press="onPrint" />
            <ToolbarSpacer id="_IDGenToolbarSpacer5" />
            <Button id="_IDGenButton6" icon="sap-icon://cancel" type="Emphasized" text="{i18n>Cancel}" press="onCancel" />
            <Button id="_IDGenButton7" icon="sap-icon://delete" type="Emphasized" text="{i18n>Delete}" press="onDelete" />
            <Button id="_IDGenButton8" icon="sap-icon://save" type="Emphasized" text="{i18n>Save}" press="onSave" />
            <Button id="_IDGenButton9" icon="sap-icon://accept" type="Emphasized" text="{i18n>Submit}" press="onSubmit" />
         </OverflowToolbar>
      </footer>
    </Page>
</mvc:View>
